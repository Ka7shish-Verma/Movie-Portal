<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Select Seat | CineVerse</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        rel="stylesheet"
        href="/css/style.css">

</head>

<body>

<nav class="navbar navbar-dark">

    <div class="container">

        <a href="/" class="navbar-brand fw-bold">
            🎬 CineVerse
        </a>

        <a href="/" class="btn btn-outline-light">
            ← Back
        </a>

    </div>

</nav>


<div class="container py-5">

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="seat-box">

                <div class="movie-heading">

                    <h2>
                        <%= movie.title %>
                    </h2>

                    <p>
                        <%= movie.genre %>
                        •
                        <%= movie.duration %>
                        •
                        <%= movie.language %>
                    </p>

                </div>


                <div class="timer-box">

                    <div>
                        Transaction Window
                    </div>

                    <strong id="timer">
                        15:00
                    </strong>

                </div>


                <div class="screen">

                    SCREEN

                </div>


                <div id="seatContainer"
                     class="seat-container">

                </div>


                <div class="legend">

                    <span>
                        <i class="legend-seat available"></i>
                        Available
                    </span>

                    <span>
                        <i class="legend-seat selected"></i>
                        Selected
                    </span>

                    <span>
                        <i class="legend-seat booked"></i>
                        Booked
                    </span>

                </div>

            </div>

        </div>


        <div class="col-lg-4">

            <div class="booking-panel">

                <h3>
                    Booking Details
                </h3>

                <hr>


                <p>
                    <strong>Movie</strong>
                    <br>
                    <%= movie.title %>
                </p>


                <p>
                    <strong>Language</strong>
                    <br>
                    <%= movie.language %>
                </p>


                <label class="form-label">
                    Select Show Time
                </label>

                <select
                    id="showTime"
                    class="form-select mb-4">

                    <option value="10:00 AM">
                        10:00 AM
                    </option>

                    <option value="01:00 PM">
                        01:00 PM
                    </option>

                    <option value="04:00 PM">
                        04:00 PM
                    </option>

                    <option value="07:00 PM">
                        07:00 PM
                    </option>

                    <option value="10:00 PM">
                        10:00 PM
                    </option>

                </select>


                <div class="selected-seat-box">

                    Selected Seat

                    <h2 id="selectedSeat">
                        None
                    </h2>

                </div>


                <button
                    id="payButton"
                    class="btn btn-danger btn-lg w-100"
                    disabled>

                    💳 Pay at Counter

                </button>


                <div
                    id="message"
                    class="mt-3">
                </div>


                <div class="counter-note">

                    <strong>
                        Payment Method
                    </strong>

                    <p>
                        Click "Pay at Counter" to generate
                        your receipt.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>


<script>

    const movieId =
        "<%= movie._id %>";

    const movieTitle =
        "<%= movie.title %>";

    const bookedSeats =
        <%- JSON.stringify(bookedSeats) %>;

</script>


<script src="/js/seats.js"></script>

</body>

</html>