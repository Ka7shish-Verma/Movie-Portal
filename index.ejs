<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>CineVerse | Movie Portal</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        rel="stylesheet"
        href="/css/style.css">

</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark">

    <div class="container">

        <a class="navbar-brand fw-bold"
           href="/">
            🎬 CineVerse
        </a>

        <button
            class="navbar-toggler"
            data-bs-toggle="collapse"
            data-bs-target="#menu">

            <span class="navbar-toggler-icon"></span>

        </button>

        <div
            class="collapse navbar-collapse"
            id="menu">

            <ul class="navbar-nav ms-auto">

                <li class="nav-item">
                    <a class="nav-link" href="/">
                        Home
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#movies">
                        Movies
                    </a>
                </li>

            </ul>

        </div>

    </div>

</nav>


<section class="hero">

    <div class="container">

        <div class="hero-content">

            <span class="badge bg-danger mb-3">
                BOOK YOUR MOVIE
            </span>

            <h1>
                Your Movie Night,
                <span>Made Unforgettable.</span>
            </h1>

            <p>
                Select your favourite movie, choose your seat
                and get your ticket at the counter.
            </p>

            <a href="#movies"
               class="btn btn-danger btn-lg">
                Explore Movies
            </a>

        </div>

    </div>

</section>


<section id="movies"
         class="container py-5">

    <div class="section-title">

        <h2>Now Showing</h2>

        <p>
            Choose a movie and reserve your favourite seat.
        </p>

    </div>


    <div class="row g-4">

        <% movies.forEach(movie => { %>

            <div class="col-lg-3 col-md-6">

                <div class="movie-card">

                    <img
                        src="<%= movie.poster %>"
                        alt="<%= movie.title %>"
                        onerror="this.src='https://via.placeholder.com/500x750?text=Movie'">

                    <div class="movie-info">

                        <h4>
                            <%= movie.title %>
                        </h4>

                        <div class="movie-meta">

                            <span>
                                ⭐ <%= movie.rating %>
                            </span>

                            <span>
                                <%= movie.year %>
                            </span>

                        </div>

                        <p>
                            <%= movie.genre %> •
                            <%= movie.duration %>
                        </p>

                        <a
                            href="/seats/<%= movie._id %>"
                            class="btn btn-danger w-100">

                            Select Seats

                        </a>

                    </div>

                </div>

            </div>

        <% }) %>

    </div>

</section>


<footer>

    <div class="container text-center">

        <h4>🎬 CineVerse</h4>

        <p>
            Your trusted movie booking portal.
        </p>

        <small>
            © 2026 CineVerse
        </small>

    </div>

</footer>


<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>

</html>